# Copy to .env for local development. Never commit the populated file.
GEMINI_API_KEY=
DEMO_CLOUD_ENABLED=1
DEMO_CLOUD_PROVIDER=gemini
DEMO_CLOUD_MODEL=gemini-3.6-flash
DEMO_GEMINI_THINKING_LEVEL=low

# Split deployment: Jetson reaches the laptop OmniVoice service through SSH.
DEMO_TTS_ENABLED=1
DEMO_TTS_PROVIDER=omnivoice
DEMO_OMNIVOICE_BASE_URL=http://127.0.0.1:8120
DEMO_OMNIVOICE_REF_AUDIO=/path/to/authorized-reference.mp3
DEMO_OMNIVOICE_REF_TEXT=/path/to/reference-transcript.txt
